# AI 生成 / 辅助创作：DeepSeek V4.1 Flash（未人工审查）
#
# 构建产物（各工程可自行重建）
*.o
*.elf

# 可上传包（.hpappdir/）是交付物，必须自包含 —— 其中的 ELF 要入库，
# 用户直接拷贝目录即可运行，不需先构建。
!*/*/*.hpappdir/my_app.elf

# 由 resources/prime-unifont/fontgen.py 从 unifont-*.hex 生成的字体源（共享一份）
resources/prime-unifont/unifont_font.c
resources/prime-unifont/unifont_font.h

# staging/prime-code 仍自带一份字体源（本轮未改）
staging/prime-code/unifont_font.c
staging/prime-code/unifont_font.h
